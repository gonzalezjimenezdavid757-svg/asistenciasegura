#.env.example

# Llave para firmar la sesión
SECRET_KEY=cambia-esta-frase-por-una-larga-y-secreta-contraseña

# Modo desarrollo: 1 activado, 0 desactivado
MODO_DESARROLLO=1

# Base de datos XAMPP
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Base de datos del equipo E4
DB_NAME=asist_e4

# Certificado SSL (vacío para XAMPP)
DB_SSL_CA=

# Clave del dispositivo ESP32
CLAVE_DISPOSITIVO=clave-de-prueba-esp32
